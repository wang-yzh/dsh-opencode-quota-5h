{
  "name": "dsh-opencode-quota-5h",
  "version": "1.0.0",
  "type": "module",
  "description": "OpenCode Go 用量状态条（5 小时药丸版）：底栏药丸只显示 5 小时窗口的已用百分比，点击展开的详情浮层保留 5 小时 / 每周 / 每月 三个窗口。",
  "homepage": "https://github.com/wang-yzh/dsh-opencode-quota-5h#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wang-yzh/dsh-opencode-quota-5h.git"
  },
  "bugs": {
    "url": "https://github.com/wang-yzh/dsh-opencode-quota-5h/issues"
  },
  "author": "wang-yzh",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "opencode",
    "opencode-go",
    "quota",
    "usage",
    "web-ui"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  }
}
